[Unit]
Description=K155 GNSS server
Documentation=https://github.com/DilnaC004/K155GNSSapp
# The receiver hangs off a serial port, and joining a network needs one.
# The phone finds the Pi over Bluetooth, so that stack has to be up first.
#
# hciuart is named as well as bluetooth. On a Pi the radio is attached over a
# UART and its firmware is flashed at boot, which takes ten seconds or so, and
# bluetooth.service counts as started long before that finishes. Waiting for
# hciuart is what makes the adapter exist by the time the server powers it up.
After=network-online.target bluetooth.service hciuart.service
Wants=network-online.target bluetooth.service hciuart.service

# Give up only after many failures, a field unit should keep trying. These
# belong in this section, systemd ignores them under [Service] and says so.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=exec
User=root
WorkingDirectory=/home/pi/GNSSApp
EnvironmentFile=/home/pi/GNSSApp/.env
ExecStart=/home/pi/GNSSApp/.venv/bin/python -m app

# Without this Python block buffers stdout, since the journal is not a
# terminal, and every diagnostic the server prints about the receiver and the
# Bluetooth adapter sits in that buffer instead of reaching the journal
Environment=PYTHONUNBUFFERED=1

# Restart on any exit, including a clean one, with a pause so a broken
# receiver cannot turn into a restart loop
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=k155-gnss

[Install]
WantedBy=multi-user.target
