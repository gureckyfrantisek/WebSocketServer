# Copy to .env and adjust. Every value here is the built-in default.

# --- Serial / GNSS receiver ---
# Raspberry Pi GPIO UART: /dev/serial0   |   Windows: COM5   |   USB uBlox: /dev/ttyACM0
SERIAL_PATH=/dev/serial0
SERIAL_BAUDRATE=115200
# Seconds between reopen attempts when the receiver is missing
SERIAL_RETRY_S=5
# 1 = generate fake NMEA instead of opening a real port (dev on a machine with no receiver)
GNSS_SIMULATE=0

# Which messages the receiver should send, as NAME:RATE pairs.
# Rate is per navigation solution, 0 switches the message off.
# Empty leaves the receiver on its own saved settings.
# Static post-processing needs RXM-RAWX and RXM-SFRBX, which only M8T, M8P and
# F9 receivers can produce - an M8N cannot.
#   UBX_MESSAGE_RATES=NMEA-GGA:1,NMEA-RMC:1,NMEA-GSV:0,RXM-RAWX:1,RXM-SFRBX:1
UBX_MESSAGE_RATES=

# Protocol generation: gen9 for ZED-F9P, gen8 for u-blox 8 and older
UBX_GENERATION=gen9
# Receiver port the messages come out of: UART1, UART2, USB, I2C or SPI.
# The GPIO pins on the Raspberry Pi are UART1.
UBX_PORT=UART1
# 1 = also store the settings in the receiver flash, they survive a reset
UBX_SAVE_TO_FLASH=0

# --- Server ---
# The Android app connects to ws://<pi-ip>:8080  -> keep 8080 unless the app changes
SERVER_PORT=8080

# --- WiFi (Raspberry Pi only, needs NetworkManager) ---
# 1 = the server keeps the Pi joined to the networks below
WIFI_MANAGED=0
# The phone hotspot. Higher priority wins when both networks are in range.
WIFI_SSID=
WIFI_PASSWORD=
WIFI_PRIORITY=20
# Fallback network, so the Pi stays reachable over SSH without the hotspot
WIFI_FALLBACK_SSID=
WIFI_FALLBACK_PASSWORD=
WIFI_FALLBACK_PRIORITY=10
# Seconds between link checks
WIFI_WATCHDOG_S=15

# --- UDP discovery beacon ---
# 0 = never broadcast, useful when testing on a busy network
DISCOVERY_ENABLED=1
DISCOVERY_PORT=41234
DISCOVERY_INTERVAL_S=1.0
WIFI_INTERFACE=wlan0

# --- Storage (stage 5) ---
LOCAL_DATA_PATH=/tmp/projects
BASE_USB_PATH=/media/pi
