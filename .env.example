# Copy to .env and adjust. Every value here is the built-in default.

# --- Serial / GNSS receiver ---
# Raspberry Pi GPIO UART: /dev/serial0   |   Windows: COM5   |   USB uBlox: /dev/ttyACM0
SERIAL_PATH=/dev/serial0
# A ZED-F9P leaves the factory with UART1 at 38400. 115200 here assumes the
# receiver was set to it. If bytes_read in /gnss/status stays at zero, or the
# sentences arrive as garbage, try 38400 or run tools/serial_probe.py.
SERIAL_BAUDRATE=115200
# Seconds between reopen attempts when the receiver is missing
SERIAL_RETRY_S=5
# 1 = generate fake NMEA instead of opening a real port (dev on a machine with no receiver)
GNSS_SIMULATE=0

# Which messages the receiver should send, as NAME:RATE pairs.
# Rate is per navigation solution, 0 switches the message off.
# Empty leaves the receiver on its own saved settings.
# Static post-processing needs RXM-RAWX and RXM-SFRBX, which only M8T, M8P and
# F9 receivers can produce - an M8N cannot.
#   UBX_MESSAGE_RATES=NMEA-GGA:1,NMEA-RMC:1,NMEA-GSV:0,RXM-RAWX:1,RXM-SFRBX:1
UBX_MESSAGE_RATES=

# Protocol generation: gen9 for ZED-F9P, gen8 for u-blox 8 and older
UBX_GENERATION=gen9
# Receiver port the messages come out of: UART1, UART2, USB, I2C or SPI.
# The GPIO pins on the Raspberry Pi are UART1.
UBX_PORT=UART1
# 1 = also store the settings in the receiver flash, they survive a reset
UBX_SAVE_TO_FLASH=0

# --- Server ---
# The Android app connects to ws://<pi-ip>:8080  -> keep 8080 unless the app changes
SERVER_PORT=8080

# What the WebSocket carries.
#   raw    every chunk exactly as it came off the port, like the Node server did
#   lines  only complete NMEA sentences, binary UBX filtered out
WS_FRAMING=raw

# --- Bluetooth handshake ---
# This is how the phone finds the Pi. It pairs once through Android settings,
# then hands over the hotspot credentials and receives the address to connect
# to. Run deploy/bluetooth_setup.sh once before this works.
BLUETOOTH_ENABLED=1
# Name shown when pairing from Android settings
BLUETOOTH_NAME=K155GNSS
BLUETOOTH_CHANNEL=1
# 1 = any phone in range can pair, which is what you need the first time.
# Set to 0 once the phone is paired: bonded devices keep working, new ones
# cannot pair any more.
BLUETOOTH_PAIRABLE=1
# Shared secret the app must send with every request that changes the Pi.
# Pairing alone does not stop a paired phone from redirecting it elsewhere.
# Generate one with: openssl rand -hex 16
BLUETOOTH_TOKEN=

# --- WiFi ---
# No credentials here on purpose. The hotspot arrives over Bluetooth and
# NetworkManager keeps the profile afterwards, so the Pi reconnects to a
# network it has already seen without any help from this server.
WIFI_INTERFACE=wlan0

# --- Storage ---
# 1 = record straight onto a USB flash drive whenever one is plugged in.
# Without a drive the recording falls back to LOCAL_DATA_PATH.
PREFER_USB=1
# Fallback folder, relative paths are resolved from the application directory.
# Do not point this at /tmp, systemd empties it.
LOCAL_DATA_PATH=data
# Where mounted drives appear. On Raspberry Pi OS this is /media/<login user>,
# which is not the user the service runs as, so it has to be written out here
# rather than worked out at runtime. Change pi if the Pi has another user.
BASE_USB_PATH=/media/pi
# Subfolder created on the drive, empty writes into the root of the drive
USB_SUBDIR=gnss
